# ─────────────────────────────────────────────────────────────
# Shree Gopi Traders — environment variables
# Copy to `.env` and fill in. NEVER commit the filled-in file.
# ─────────────────────────────────────────────────────────────

# ── Database (required) ──
# Pooled PostgreSQL connection string (Neon / Supabase / Vercel Postgres).
DATABASE_URL=
# Direct (non-pooled) connection. Prisma uses this for migrations.
# On providers without a separate direct URL, set it to the same value.
DIRECT_URL=

# ── Auth (required) ──
# Signs the admin + customer session cookies.
# Generate with: openssl rand -base64 32
# Must be at least 16 characters; the app refuses to boot in production without it.
AUTH_SECRET=

# ── Seed-only admin bootstrap (required to run `npm run seed`) ──
# These create the first admin login. Change the password from the
# admin Settings page immediately after the first production sign-in.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ── Public site config (exposed to the browser — never put secrets here) ──
# Full origin, no trailing slash. Used for canonical URLs, sitemap and OpenGraph.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_BRAND_NAME="Shree Gopi Traders"
# Country code + number, digits only, e.g. 919876543210.
# Leave blank to hide every WhatsApp CTA rather than render a dead link.
NEXT_PUBLIC_WHATSAPP_NUMBER=

# ─────────────────────────────────────────────────────────────
# Not used in V1 — Cash on Delivery is the only payment method.
# Reserved so online payments can be added without a schema change.
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=

# ── Cloudinary (optional) ────────────────────────────────────────
# Only needed to RUN the image uploader (npm run images:cloudinary).
# The storefront never calls Cloudinary's API — it just loads the delivery
# URLs — so these are absent from production and from every client bundle.
# None carry a NEXT_PUBLIC_ prefix, so Next cannot inline them into browser JS.
# Find them under Settings -> API Keys in the Cloudinary console.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=shree-gopi-traders/products

# ── Order emails (optional) ──────────────────────────────────────
# Without these the store still takes orders; confirmations are logged as
# SKIPPED instead of sent. None carry a NEXT_PUBLIC_ prefix, so Next cannot
# inline them into browser JavaScript.
#
# Use an APP PASSWORD, never the mailbox account password.
#   Zoho:  smtp.zoho.in       port 465
#   Gmail: smtp.gmail.com     port 465  (requires a Google app password)
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="Shree Gopi Traders <orders@yourdomain.com>"
MAIL_REPLY_TO=
