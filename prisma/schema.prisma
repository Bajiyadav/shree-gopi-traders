generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Admin {
  id                    String                 @id @default(cuid())
  name                  String
  email                 String                 @unique
  passwordHash          String
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  inventoryTransactions InventoryTransaction[]

  @@index([email])
}

/// One failed sign-in, counted against a scope — either `ip:<address>` or
/// `user:<email>`. src/lib/rate-limit.ts reads a rolling 15-minute window over
/// these rows to throttle brute-force attempts, and prunes expired ones as it
/// goes. Holds no credentials: a scope string and a timestamp, nothing else.
model LoginAttempt {
  id        String   @id @default(cuid())
  scope     String
  createdAt DateTime @default(now())

  @@index([scope, createdAt])
}

model Customer {
  id                String             @id @default(cuid())
  name              String
  email             String             @unique
  phone             String
  passwordHash      String
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  addresses         Address[]
  bulkOrderRequests BulkOrderRequest[]
  businessProfile   BusinessProfile?
  cart              Cart?
  orders            Order[]
  reviews           Review[]

  @@index([email])
  @@index([phone])
}

model BusinessProfile {
  id           String       @id @default(cuid())
  customerId   String       @unique
  businessName String
  businessType BusinessType @default(OTHER)
  gstNumber    String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  customer     Customer     @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([businessName])
}

model Address {
  id         String   @id @default(cuid())
  customerId String
  label      String?
  line1      String
  line2      String?
  city       String
  state      String
  pincode    String
  isDefault  Boolean  @default(false)
  createdAt  DateTime @default(now())
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
}

model Category {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  description String?
  imageUrl    String?
  isActive    Boolean   @default(true)
  sortOrder   Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  products    Product[]

  @@index([slug])
  @@index([isActive])
}

model Product {
  id                String           @id @default(cuid())
  name              String
  slug              String           @unique
  description       String?
  specs             Json?
  brand             String?
  sku               String           @unique
  categoryId        String
  images            String[]
  basePrice         Decimal          @db.Decimal(10, 2)
  salePrice         Decimal?         @db.Decimal(10, 2)
  weight            Decimal?         @db.Decimal(10, 2)
  isActive          Boolean          @default(true)
  allowBackorder    Boolean          @default(false)
  ratingAvg         Decimal          @default(0) @db.Decimal(3, 2)
  ratingCount       Int              @default(0)
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  /// Optional long-form content for the product detail tabs. Null means the
  /// tab is not rendered — never show an empty tab.
  ingredients       String?
  /// Minimum order quantity. B2B buyers expect to see this up front;
  /// 1 means "no minimum", which is itself worth stating.
  moq               Int              @default(1)
  usageInstructions String?
  orderItems        OrderItem[]
  category          Category         @relation(fields: [categoryId], references: [id])
  variants          ProductVariant[]
  reviews           Review[]

  @@index([categoryId])
  @@index([isActive])
  @@index([slug])
  @@index([sku])
  @@index([brand])
}

model ProductVariant {
  id             String               @id @default(cuid())
  productId      String
  name           String
  sku            String               @unique
  price          Decimal              @db.Decimal(10, 2)
  wholesalePrice Decimal?             @db.Decimal(10, 2)
  weight         Decimal?             @db.Decimal(10, 2)
  imageUrl       String?
  isActive       Boolean              @default(true)
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  salePrice      Decimal?             @db.Decimal(10, 2)
  cartItems      CartItem[]
  inventory      Inventory?
  orderItems     OrderItem[]
  product        Product              @relation(fields: [productId], references: [id], onDelete: Cascade)
  wholesaleTiers WholesalePriceTier[]

  @@index([productId])
  @@index([sku])
}

model WholesalePriceTier {
  id               String         @id @default(cuid())
  productVariantId String
  minQty           Int
  maxQty           Int?
  pricePerUnit     Decimal        @db.Decimal(10, 2)
  createdAt        DateTime       @default(now())
  productVariant   ProductVariant @relation(fields: [productVariantId], references: [id], onDelete: Cascade)

  @@index([productVariantId])
  @@index([minQty])
}

model Inventory {
  id                String                 @id @default(cuid())
  productVariantId  String                 @unique
  stock             Int                    @default(0)
  lowStockThreshold Int                    @default(5)
  updatedAt         DateTime               @updatedAt
  productVariant    ProductVariant         @relation(fields: [productVariantId], references: [id], onDelete: Cascade)
  transactions      InventoryTransaction[]

  @@index([stock])
}

model InventoryTransaction {
  id          String          @id @default(cuid())
  inventoryId String
  action      InventoryAction
  quantity    Int
  reason      String?
  adminId     String?
  orderId     String?
  createdAt   DateTime        @default(now())
  admin       Admin?          @relation(fields: [adminId], references: [id])
  inventory   Inventory       @relation(fields: [inventoryId], references: [id], onDelete: Cascade)

  @@index([inventoryId])
  @@index([createdAt])
}

model Cart {
  id         String     @id @default(cuid())
  customerId String     @unique
  couponCode String?
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  customer   Customer   @relation(fields: [customerId], references: [id], onDelete: Cascade)
  items      CartItem[]
}

model CartItem {
  id               String         @id @default(cuid())
  cartId           String
  productVariantId String
  quantity         Int
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  cart             Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  productVariant   ProductVariant @relation(fields: [productVariantId], references: [id])

  @@unique([cartId, productVariantId])
}

model Order {
  id                   String        @id @default(cuid())
  orderNumber          String        @unique
  customerId           String
  businessName         String?
  subtotal             Decimal       @db.Decimal(10, 2)
  bulkDiscount         Decimal       @default(0) @db.Decimal(10, 2)
  couponDiscount       Decimal       @default(0) @db.Decimal(10, 2)
  couponCode           String?
  deliveryFee          Decimal       @default(0) @db.Decimal(10, 2)
  tax                  Decimal       @default(0) @db.Decimal(10, 2)
  total                Decimal       @db.Decimal(10, 2)
  paymentMethod        PaymentMethod @default(COD)
  paymentStatus        PaymentStatus @default(PENDING)
  status               OrderStatus   @default(PENDING)
  shippingAddress      Json
  billingAddress       Json?
  gstNumber            String?
  deliveryInstructions String?
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt
  delivery             Delivery?
  invoice              Invoice?
  customer             Customer      @relation(fields: [customerId], references: [id])
  items                OrderItem[]

  @@index([customerId])
  @@index([status])
  @@index([createdAt])
  @@index([orderNumber])
}

model OrderItem {
  id               String         @id @default(cuid())
  orderId          String
  productId        String
  productVariantId String
  productName      String
  variantName      String
  quantity         Int
  unitPrice        Decimal        @db.Decimal(10, 2)
  listPrice        Decimal        @db.Decimal(10, 2)
  lineTotal        Decimal        @db.Decimal(10, 2)
  order            Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product          Product        @relation(fields: [productId], references: [id])
  productVariant   ProductVariant @relation(fields: [productVariantId], references: [id])

  @@index([orderId])
  @@index([productId])
  @@index([productVariantId])
}

/// A bill issued against an order. Deliberately minimal: the Order and its
/// OrderItems already hold immutable price snapshots, so an invoice never
/// copies money figures — it only fixes an identifier and a date. That keeps
/// the bill and the order mathematically incapable of disagreeing.
model Invoice {
  id            String   @id @default(cuid())
  invoiceNumber String   @unique
  orderId       String   @unique
  invoiceDate   DateTime @default(now())
  createdAt     DateTime @default(now())
  order         Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([invoiceNumber])
  @@index([invoiceDate])
}

model BulkOrderRequest {
  id               String          @id @default(cuid())
  customerId       String?
  companyName      String
  contactPerson    String
  phone            String
  email            String
  productsNote     String
  expectedDate     DateTime?
  deliveryLocation String
  additionalNotes  String?
  quotedAmount     Decimal?        @db.Decimal(10, 2)
  status           BulkOrderStatus @default(PENDING)
  convertedOrderId String?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  customer         Customer?       @relation(fields: [customerId], references: [id])

  @@index([status])
  @@index([createdAt])
}

model Delivery {
  id                   String         @id @default(cuid())
  orderId              String         @unique
  status               DeliveryStatus @default(PENDING)
  courierName          String?
  trackingNumber       String?
  expectedDeliveryDate DateTime?
  deliveryNotes        String?
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt
  order                Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([status])
}

model Review {
  id         String       @id @default(cuid())
  productId  String
  customerId String
  rating     Int
  comment    String?
  status     ReviewStatus @default(PENDING)
  createdAt  DateTime     @default(now())
  customer   Customer     @relation(fields: [customerId], references: [id])
  product    Product      @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([status])
}

model ContactMessage {
  id           String        @id @default(cuid())
  name         String
  businessName String?
  phone        String
  email        String
  message      String
  status       EnquiryStatus @default(UNREAD)
  createdAt    DateTime      @default(now())

  @@index([status])
  @@index([createdAt])
}

model Coupon {
  id            String       @id @default(cuid())
  code          String       @unique
  discountType  DiscountType
  discountValue Decimal      @db.Decimal(10, 2)
  minOrderValue Decimal?     @db.Decimal(10, 2)
  maxDiscount   Decimal?     @db.Decimal(10, 2)
  startDate     DateTime
  endDate       DateTime
  usageLimit    Int?
  usageCount    Int          @default(0)
  isActive      Boolean      @default(true)
  createdAt     DateTime     @default(now())

  @@index([code])
  @@index([isActive])
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  PACKED
  SHIPPED
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
  COD
}

enum PaymentMethod {
  COD
  RAZORPAY
  UPI
  CARD
}

enum DeliveryStatus {
  PENDING
  PACKED
  SHIPPED
  OUT_FOR_DELIVERY
  DELIVERED
  FAILED
}

enum BulkOrderStatus {
  PENDING
  REVIEWING
  QUOTED
  APPROVED
  REJECTED
  COMPLETED
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

enum EnquiryStatus {
  UNREAD
  READ
  ARCHIVED
}

enum DiscountType {
  PERCENTAGE
  FIXED
}

enum InventoryAction {
  RESTOCK
  ORDER
  ADJUSTMENT
  RETURN
  DAMAGE
}

enum BusinessType {
  SALON
  PARLOUR
  SPA
  BEAUTY_STUDIO
  MAKEUP_ARTIST
  BARBERSHOP
  ACADEMY
  RETAILER
  OTHER
}
